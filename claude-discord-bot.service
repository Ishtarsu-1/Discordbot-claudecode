[Unit]
Description=Discord /claude bot for Claude Code
After=network-online.target

[Service]
# __DIR__ is replaced by the install command in the README
WorkingDirectory=__DIR__
# bash -l loads your login PATH (node, claude installed via nvm/mise/etc.)
ExecStart=/bin/bash -lc 'exec npm start'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
