# Discord developer portal > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=
# Only this user can run /claude: your numeric Discord ID (recommended) or your username
DISCORD_OWNER=
# Absolute path of the project Claude Code works in
PROJECT_DIR=
# Webhook of the channel that receives Claude's answers (optional, otherwise printed to the console)
DISCORD_WEBHOOK_URL=
# Claude Code permission mode: auto (default), acceptEdits, plan, bypassPermissions...
CLAUDE_PERMISSION_MODE=auto
